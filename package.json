{
  "name": "natik",
  "private": true,
  "description": "Natik Language Centre: website and online learning platform",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lhci": "lhci autorun",
    "dev": "pnpm services:up && turbo run dev",
    "dev:apps": "turbo run dev",
    "dev:warm": "node scripts/warm-routes.mjs",
    "preview": "pnpm build && turbo run start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "e2e": "pnpm --filter @natik/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose -f docker/compose.dev.yml up -d --wait postgres redis storage mailpit && docker compose -f docker/compose.dev.yml --profile init run --rm storage-init",
    "services:down": "docker compose -f docker/compose.dev.yml down",
    "db:migrate": "pnpm --filter @natik/api db:migrate",
    "db:seed": "pnpm --filter @natik/api db:seed",
    "db:reset": "pnpm --filter @natik/api db:reset",
    "db:studio": "pnpm --filter @natik/api db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}": "prettier --write"
  }
}
