{
  "name": "@natik/web",
  "version": "0.0.0",
  "private": true,
  "description": "Natik website and learning platform (Next.js)",
  "scripts": {
    "dev": "node ../../scripts/dev-web.mjs",
    "dev:plain": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "messages:scan": "node scripts/client-messages.mjs",
    "lint": "node scripts/client-messages.mjs --check && eslint .",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@natik/shared": "workspace:*",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tus-js-client": "4.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@natik/config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  }
}
