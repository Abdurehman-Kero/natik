{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start --port 3200",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3200/", "http://localhost:3200/courses"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "interactive": ["error", { "maxNumericValue": 3000 }],
        "total-byte-weight": ["error", { "maxNumericValue": 1500000 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 153600 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
