# Natik web: copy to .env.local and adjust. Never commit .env files.

# local | staging | production  (production hides /styleguide and allows search indexing)
APP_ENV=local

# Public URL of the site (used for metadata, Open Graph and sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where the Next.js server reaches the NestJS API
API_INTERNAL_URL=http://localhost:4000

# Natik's public contact details. Anything left empty is simply not shown on the site.
SITE_PHONE=
SITE_EMAIL=
SITE_ADDRESS=
SITE_HOURS=
SITE_MAP_URL=
SITE_TELEGRAM=
SITE_FACEBOOK=
SITE_INSTAGRAM=
SITE_TIKTOK=
SITE_YOUTUBE=
