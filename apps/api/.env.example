# Natik API: copy to .env and adjust. Never commit .env.

NODE_ENV=development
# local | test | staging | production  (production hides /api/docs)
APP_ENV=local
API_PORT=4000
APP_URL=http://localhost:3000
# Proxies in front of the API: 1 = one (Caddy/Cloudflare/Render), 2 = Vercel in front of Render.
TRUST_PROXY_HOPS=1
LOG_LEVEL=debug

# docker/compose.dev.yml services
DATABASE_URL=postgresql://natik:natik@localhost:5440/natik?schema=public
# Integration tests run here, never against DATABASE_URL
TEST_DATABASE_URL=postgresql://natik:natik@localhost:5440/natik_test?schema=public
REDIS_URL=redis://localhost:6380

# Local dev runs the background worker inside the API process.
# In staging/production run `node dist/worker.js` as its own process and set this to false.
RUN_WORKER_IN_API=true

# Error tracking (leave empty locally)
SENTRY_DSN=

# Seed: first Owner admin (used by `pnpm db:seed`)
SEED_OWNER_NAME=Natik Owner
SEED_OWNER_EMAIL=owner@natik.test
SEED_OWNER_PHONE=+251911000000
SEED_OWNER_PASSWORD=ChangeMe2026

# Secret mixed into stored SMS-code hashes (16+ characters). Must be set in staging/production.
OTP_PEPPER=dev-only-otp-pepper-change-me
# console    = nothing is sent; codes appear in the API log and at /dev/sms (local only)
# afromessage = real SMS through Afro Message (set AFROMESSAGE_TOKEN below)
SMS_PROVIDER=console
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
SMS_SENDER=Natik

# S3-compatible private storage (docker/compose.dev.yml uses RustFS)
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=natik-private
S3_ACCESS_KEY=natik
S3_SECRET_KEY=natik-dev-secret
S3_FORCE_PATH_STYLE=true

# Test-only: multiply request limits (browser tests set 100). Keep 1 otherwise.
RATE_LIMIT_MULTIPLIER=1

# Lesson videos. local = stored in our own storage (development only, max 100 MB).
# bunny = Bunny Stream (staging/production): create a library, enable token authentication,
# and set the allowed domain to your website.
VIDEO_PROVIDER=local
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_KEY=
